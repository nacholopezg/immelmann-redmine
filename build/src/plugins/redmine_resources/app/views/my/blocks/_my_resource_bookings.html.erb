<%
  block = :my_resource_bookings
  my_page_settings = User.current.pref[:my_page_settings] || {}
  settings ||= my_page_settings[block] || {} # In Redmine versions < 3.4 not defined settings variable

  show_weekends = settings[:show_weekends] != '0'
  show_project_names = settings[:show_project_names] != '0'
  show_spent_time = settings[:show_spent_time] != '0'

  chart = RedmineResources::Charts::MyResourceBookingsChart.new(User.current)
%>

<% if Redmine::VERSION.to_s >= '3.4' %>
  <div class="contextual">
    <%= link_to_function l(:label_options), "$('##{block}-settings').toggle();", class: 'icon-only icon-settings', title: l(:label_options) %>
  </div>
<% end %>

<h3>
  <%= link_to l(:label_my_resource_bookings), chart.title_url_options %>
  <%= chart.render_summary %>
  <%= link_to l(:button_log_time), new_time_entry_path, class: 'icon-only icon-time-add', title: l(:button_log_time) if User.current.allowed_to?(:log_time, nil, global: true) %>
</h3>

<!--Widget settings-->
<% if Redmine::VERSION.to_s >= '3.4' %>
  <div id="<%= block %>-settings" style="display:none;">
    <%= form_tag(my_page_path, remote: true) do %>
      <div class="box">
        <div style="display: block;">
          <table>
            <tbody>
            <tr>
              <td><%= l(:button_show) %></td>
              <td>
                <label for="settings_my_resource_bookings_show_weekends">
                  <%= hidden_field_tag "settings[my_resource_bookings][show_weekends]", 0, id: nil %>
                  <%= check_box_tag 'settings[my_resource_bookings][show_weekends]', 1, show_weekends,  onclick: "$('.week-end').toggle();" %>
                  <%= l(:label_resources_weekends) %>
                </label>
                <label for="settings_my_resource_bookings_show_project_names">
                  <%= hidden_field_tag "settings[my_resource_bookings][show_project_names]", 0, id: nil %>
                  <%= check_box_tag 'settings[my_resource_bookings][show_project_names]', 1, show_project_names,  onclick: "$('.project-name').toggle();" %>
                  <%= l(:label_resources_project_names) %>
                </label>
                <label for="settings_my_resource_bookings_show_spent_time">
                  <%= hidden_field_tag "settings[my_resource_bookings][show_spent_time]", 0, id: nil %>
                  <%= check_box_tag 'settings[my_resource_bookings][show_spent_time]', 1, show_spent_time,  onclick: "$('.spent').toggle();" %>
                  <%= l(:label_spent_time) %>
                </label>
              </td>
            </tr>
            </tbody>
          </table>
        </div>
      </div>

      <p>
        <%= submit_tag l(:button_save) %>
        <%= link_to_function l(:button_cancel), "$('##{block}-settings').toggle();" %>
      </p>
    <% end %>
  </div>
<% end %>

<!--Render chart-->
<% if chart.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
  <div class="my-resource-bookings-chart">
    <table class="cal">
      <thead>
        <tr>
          <% chart.plans.each do |plan| %>
            <th scope="col" class="<%= plan.week_day_css_class %>"><%= plan.date_title %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <tr>
          <% chart.plans.each do |plan| %>
            <td class="<%= plan.week_day_css_class %>"><%= plan.workload_card.render %></td>
          <% end %>
        </tr>

        <tr class="booking-data">
          <% chart.plans.each do |plan| %>
            <td class="<%= plan.today_css_class %> <%= plan.week_day_css_class %>">
              <% plan.booked_cards.each do |booked_card| %>
                <%= booked_card.render %>
              <% end %>

              <% if plan.unbooked_cards.present? %>
                <p class="spent group-name"><%= l(:label_resources_unbooked_time) %></p>
                <% plan.unbooked_cards.each do |unbooked_card| %>
                  <%= unbooked_card.render %>
                <% end %>
              <% end %>
            </td>
          <% end %>
        </tr>
      </tbody>
    </table>
  </div>
<% end %>

<%= javascript_tag do %>
  // Apply widget settings
  $(function() {
    $('.week-end').toggle(<%= show_weekends %>);
    $('.project-name').toggle(<%= show_project_names %>);
    $('.spent').toggle(<%= show_spent_time %>);
  });
<% end %>
