<% if @can[:edit] && @project.try(:agile_sprints_any?) %>
  <li class="folder">
    <a href="#" class="submenu"><%= l(:label_agile_sprint) %></a>
    <ul>
    <% AgileSprint.for_project(@project).available.each do |agile_sprint| %>
        <li><%= context_menu_link agile_sprint.to_s, bulk_update_issues_path(ids: @issue_ids, issue: {agile_data_attributes: { agile_sprint_id: agile_sprint.id } }, back_url: @back), method: :post, selected: (@issue && @issue.agile_sprint == agile_sprint) %></li>
    <% end -%>
    </ul>
  </li>
<% end %>
